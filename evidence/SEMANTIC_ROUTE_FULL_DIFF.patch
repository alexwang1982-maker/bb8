+        # 否则助手模式/普通聊天也会悄悄改掉下一次重复转头的方向。
+        had_last = key in _last_robot
+        old_last = _last_robot.get(key)
+        try:
+            fast = local_fast(t, key)
+        finally:
+            if had_last:
+                _last_robot[key] = old_last
+            else:
+                _last_robot.pop(key, None)
+        if not fast:
+            return None
+        kind, payload = fast
